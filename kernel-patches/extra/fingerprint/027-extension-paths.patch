+namespace {
+
+// Prefs key under extensions.settings.<id> recording which version the
+// --extension_paths flow last installed.  Unpacked extensions never persist
+// their manifest in prefs (ExtensionPrefs::UpdateManifest skips kUnpacked), so
+// ExtensionPrefs::GetVersionString() can't tell whether the on-disk version is
+// already installed — this marker can.
+constexpr char kVeilInstalledVersionPref[] = "veil_installed_version";
+
+// Loads the manifest of one --extension_paths entry off the UI thread.  Runs
+// on a base::ThreadPool task runner; the ID/version of the resulting probe
+// decides install vs skip vs update in OnVeilExtensionPathProbed().
+VeilExtensionProbe ProbeVeilExtensionPath(const base::FilePath& path) {
+  VeilExtensionProbe probe;
+  probe.abs_path =
+      base::MakeAbsoluteFilePath(path_util::ResolveHomeDirectory(path));
+  if (probe.abs_path.empty()) {
+    probe.error = u"path does not exist";
+    return probe;
+  }
+  std::u16string error;
+  scoped_refptr<const Extension> extension = file_util::LoadExtension(
+      probe.abs_path, mojom::ManifestLocation::kUnpacked, 0 /*flags*/, &error);
+  if (!extension) {
+    probe.error = error;
+    return probe;
+  }
+  probe.ok = true;
+  probe.id = extension->id();
+  probe.version = extension->version().GetString();
+  return probe;
+}
+
+}  // namespace
+
+void ExtensionService::LoadVeilExtensionPaths() {
+  // --extension_paths installs each listed extension into the profile exactly
+  // like the chrome://extensions "Load unpacked" flow instead of the
+  // --load-extension command-line flow.  The install flow (UnpackedInstaller →
+  // ExtensionRegistrar::AddNewOrUpdatedExtension → FinishInstallation) is what
+  // arms the pending-on-install pref that dispatches chrome.runtime.onInstalled
+  // when the extension's service worker first loads: with no previously stored
+  // version it fires reason "install".  Plain restarts load the extension via
+  // InstalledLoader → AddExtension, which arms nothing — so with an unchanged
+  // on-disk version we skip entirely and no event fires, exactly like a
+  // normally-installed extension.  A version bump on disk re-runs the install
+  // flow, firing the normal "update" event.
+  if (!command_line_->HasSwitch(switches::kExtensionPaths)) {
+    return;
+  }
+
+  // The developer-mode toggle was already forced on in Init() before
+  // InstalledLoader ran, so unpacked extensions installed by this switch are
+  // never gated by the unsupported-developer policy.
+
+  base::CommandLine::StringType path_list =
+      command_line_->GetSwitchValueNative(switches::kExtensionPaths);
+  base::StringTokenizerT<base::CommandLine::StringType,
+                         base::CommandLine::StringType::const_iterator>
+      t(path_list, FILE_PATH_LITERAL(","));
+  while (t.GetNext()) {
+    // The manifest probe hits the disk; keep it off the UI thread.
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+        base::BindOnce(&ProbeVeilExtensionPath,
+                       base::FilePath(t.token_piece())),
+        base::BindOnce(&ExtensionService::OnVeilExtensionPathProbed,
+                       weak_ptr_factory_.GetWeakPtr()));
+  }
+}
+
+void ExtensionService::OnVeilExtensionPathProbed(
+    VeilExtensionProbe probe) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (!probe.ok) {
+    LOG(WARNING) << "--extension_paths: " << probe.abs_path << ": "
+                 << probe.error;
+    return;
+  }
+  ExtensionPrefs* prefs = ExtensionPrefs::Get(profile_);
+  std::string installed_version;
+  prefs->ReadPrefAsString(probe.id, kVeilInstalledVersionPref,
+                          &installed_version);
+  if (installed_version == probe.version) {
+    // Already installed and current: InstalledLoader loaded it from prefs
+    // like any normally-installed extension; no onInstalled event.  Belt and
+    // suspenders against any disable gate (developer-mode resets, or a future
+    // time-based expiry built on it): this switch is the install authority,
+    // so clear the unsupported-developer reason and re-enable.
+    DisableReasonSet reasons = prefs->GetDisableReasons(probe.id);
+    if (reasons.contains(
+            disable_reason::DISABLE_UNSUPPORTED_DEVELOPER_EXTENSION)) {
+      reasons.erase(disable_reason::DISABLE_UNSUPPORTED_DEVELOPER_EXTENSION);
+      prefs->RemoveDisableReason(
+          probe.id, disable_reason::DISABLE_UNSUPPORTED_DEVELOPER_EXTENSION);
+      if (reasons.empty()) {
+        extension_registrar_->EnableExtension(probe.id);
+      }
+    }
+    return;
+  }
+  // Fresh install (reason "install") or a bumped on-disk version (reason
+  // "update"): run the normal unpacked-install flow, which fires
+  // chrome.runtime.onInstalled exactly once per change.
+  scoped_refptr<UnpackedInstaller> installer =
+      UnpackedInstaller::Create(profile_);
+  installer->set_completion_callback(base::BindOnce(
+      &ExtensionService::OnVeilExtensionInstalled,
+      weak_ptr_factory_.GetWeakPtr(), probe.version));
+  installer->Load(probe.abs_path);
+}
+
+void ExtensionService::OnVeilExtensionInstalled(
+    const std::string& version,
+    const Extension* extension,
+    const base::FilePath& path,
+    const std::u16string& error) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (!extension) {
+    LOG(WARNING) << "--extension_paths: " << path.value() << ": " << error;
+    return;
+  }
+  ExtensionPrefs::Get(profile_)->UpdateExtensionPref(
+      extension->id(), kVeilInstalledVersionPref, base::Value(version));
+}
