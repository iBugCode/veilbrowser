                                mojom::blink::ColorScheme color_scheme,
                                const ui::ColorProvider* color_provider,
                                bool can_expose_accent_color) const {
+  // Headless masking: the headless color provider computes garbage for some
+  // CSS system colors; report the Windows light palette like a headful
+  // session (ActiveText is link blue on Windows Chrome, not the red spec
+  // default).
+  static const bool headless =
+      base::CommandLine::ForCurrentProcess()->HasSwitch("headless");
+  if (headless) {
+    if (css_value_id == CSSValueID::kActivetext)
+      return Color::FromRGBA32(0xFF0000FF);
+    return DefaultSystemColor(css_value_id, color_scheme, color_provider,
+                              can_expose_accent_color);
+  }
   if (color_provider && !WebTestSupport::IsRunningWebTest()) {
     return SystemColorFromColorProvider(
         css_value_id, color_scheme, color_provider, can_expose_accent_color);
