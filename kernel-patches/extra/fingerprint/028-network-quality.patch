+// veilbrowser: with the --fingerprint switch the renderer's network
+// quality estimates are replaced with seed-derived plausible values. On
+// headless or proxied launches the estimator has no data and
+// navigator.connection then reports the spec's unknown-value tell --
+// rtt = 0, downlink = 10 Mbps -- constant across sessions and sites
+// (CloakBrowser #447).
+bool VeilFingerprintActive() {
+  static const bool active =
+      base::CommandLine::ForCurrentProcess()->HasSwitch("fingerprint");
+  return active;
+}
+
+uint64_t VeilSeedHash(const char* salt) {
+  std::string s = base::CommandLine::ForCurrentProcess()
+                      ->GetSwitchValueASCII("fingerprint");
+  s += salt;
+  return std::hash<std::string>{}(s);
+}
+
 }  // namespace
 
+WebEffectiveConnectionType VeilSeededEffectiveType() {
+  if (!VeilFingerprintActive())
+    return WebEffectiveConnectionType::kTypeUnknown;
+  return WebEffectiveConnectionType::kType4G;
+}
+
+std::optional<base::TimeDelta> VeilSeededHttpRtt() {
+  if (!VeilFingerprintActive())
+    return std::nullopt;
+  return base::Milliseconds(
+      40 + static_cast<int>(VeilSeedHash(":http-rtt") % 19) * 5);
+}
+
+std::optional<base::TimeDelta> VeilSeededTransportRtt() {
+  if (!VeilFingerprintActive())
+    return std::nullopt;
+  const int http_rtt_ms =
+      40 + static_cast<int>(VeilSeedHash(":http-rtt") % 19) * 5;
+  const int transport_rtt_ms =
+      std::max(25, http_rtt_ms - 15 -
+                       static_cast<int>(VeilSeedHash(":transport-rtt") % 25));
+  return base::Milliseconds(transport_rtt_ms);
+}
+
+std::optional<double> VeilSeededDownlinkMbps() {
+  if (!VeilFingerprintActive())
+    return std::nullopt;
+  static constexpr double kVeilDownlinkMbps[] = {2.4, 3.1, 3.9,
+                                                 4.6, 5.8, 6.9, 8.4, 9.2};
+  return kVeilDownlinkMbps[VeilSeedHash(":downlink") %
+                           std::size(kVeilDownlinkMbps)];
+}
