+namespace {
+
+// veilbrowser: family (already lowercase) -> embedded metric clone key.
+// Everything not listed below maps to the sans clone, mirroring how a real
+// Windows machine resolves unknown display faces to a sans-serif fallback.
+bool VeilIsGenericFontName(const std::string& family) {
+  static const char* const kGeneric[] = {
+      "serif", "sans-serif", "monospace", "cursive", "fantasy", "math",
+      "fangsong", "system-ui", "ui-serif", "ui-sans-serif", "ui-monospace",
+      "ui-rounded", "-webkit-standard", "-webkit-body", "-webkit-pictograph",
+      "none", "inherit", "initial", "unset"};
+  for (const char* g : kGeneric) {
+    if (family == g) {
+      return true;
+    }
+  }
+  return !family.empty() && family[0] == '-';
+}
+
+const char* VeilEmbeddedFontKey(const std::string& requested) {
+  static const std::set<std::string> kSerif = {
+      "times new roman", "times", "palatino linotype", "palatino",
+      "constantia", "sitka", "garamond", "baskerville", "big caslon",
+      "didot", "hoefler text", "rockwell", "charter", "superclarendon",
+      "book antiqua", "bookman old style", "century schoolbook"};
+  static const std::set<std::string> kMono = {
+      "courier new", "courier", "consolas", "lucida console",
+      "cascadia code", "cascadia mono", "menlo", "monaco", "sf mono",
+      "pt mono"};
+  if (requested == "calibri") {
+    return "calibri";
+  }
+  if (requested == "cambria" || requested == "cambria math") {
+    return "cambria";
+  }
+  if (requested == "georgia") {
+    return "georgia";
+  }
+  if (kSerif.count(requested)) {
+    return "times new roman";
+  }
+  if (kMono.count(requested)) {
+    return "courier new";
+  }
+  return "arial";
+}
+
+// Builds the FontPlatformData for an embedded metric clone, or nullptr when
+// the request is not eligible (generic name / no clone for this platform).
+const FontPlatformData* VeilEmbeddedFontPlatformData(
+    const std::string& requested_family,
+    const std::string& spoofed_platform,
+    const FontDescription& font_description) {
+  if (spoofed_platform != "windows" && spoofed_platform != "macos") {
+    return nullptr;
+  }
+  if (VeilIsGenericFontName(requested_family)) {
+    return nullptr;
+  }
+  // Only families the spoofed platform actually ships may resolve; unknown
+  // names must stay unavailable (fonts.check on a made-up family is false
+  // on real Chrome).
+  static const std::set<std::string> kWindowsFonts = [] {
+    std::set<std::string> names;
+    for (const std::string& f : GetPlatformFonts("windows")) {
+      names.insert(base::ToLowerASCII(f));
+    }
+    return names;
+  }();
+  static const std::set<std::string> kMacFonts = [] {
+    std::set<std::string> names;
+    for (const std::string& f : GetPlatformFonts("macos")) {
+      names.insert(base::ToLowerASCII(f));
+    }
+    return names;
+  }();
+  const std::set<std::string>& platform_fonts =
+      spoofed_platform == "windows" ? kWindowsFonts : kMacFonts;
+  if (!platform_fonts.count(requested_family)) {
+    return nullptr;
+  }
+  sk_sp<SkTypeface> typeface =
+      veil::VeilEmbeddedTypeface(VeilEmbeddedFontKey(requested_family));
+  if (!typeface) {
+    return nullptr;
+  }
+  SkString skia_family_name;
+  typeface->getFamilyName(&skia_family_name);
+  bool synthetic_bold = font_description.Weight() >= kBoldThreshold &&
+                        !typeface->isBold() &&
+                        font_description.SyntheticBoldAllowed();
+  bool synthetic_italic = font_description.Style() > kNormalSlopeValue &&
+                          !typeface->isItalic() &&
+                          font_description.SyntheticItalicAllowed();
+  return MakeGarbageCollected<FontPlatformData>(
+      std::move(typeface), skia_family_name.c_str(),
+      font_description.EffectiveFontSize(), synthetic_bold, synthetic_italic,
+      font_description.TextRendering(), ResolvedFontFeatures(),
+      font_description.Orientation());
+}
