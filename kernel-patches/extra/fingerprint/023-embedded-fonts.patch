+sk_sp<SkTypeface> VeilEmbeddedTypeface(const std::string& key) {
+  static const base::NoDestructor<std::map<std::string, sk_sp<SkTypeface>>>
+      typefaces([] {
+        std::map<std::string, sk_sp<SkTypeface>> map;
+        for (const EmbeddedFont& font : kEmbeddedFonts) {
+          std::string decoded;
+          if (!base::Base64Decode(font.b64, &decoded)) {
+            continue;
+          }
+          // Decode through blink's web-font pipeline (OTS sanitizer +
+          // FreeType): the platform SkFontMgr (FontConfig) does not support
+          // makeFromStream and would silently return null.
+          scoped_refptr<SharedBuffer> buffer =
+              SharedBuffer::Create(base::span(decoded));
+          auto decoded_font = DecodedWebFont::Create(buffer.get());
+          if (decoded_font.has_value()) {
+            map.emplace(font.key, std::move(decoded_font->sk_typeface));
+          } else {
+            LOG(WARNING) << "veil-fonts: decode FAILED for " << font.key
+                         << ": " << decoded_font.error();
+          }
+        }
+        return map;
+      }());
+  auto it = typefaces->find(key);
+  return it != typefaces->end() ? it->second : nullptr;
+}
