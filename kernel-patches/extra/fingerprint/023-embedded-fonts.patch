+// Copyright 2026 The veilbrowser Authors. BSD-style license.
+// Metric-compatible fonts embedded in the binary so measureText / font
+// availability match a real Windows/macOS Chrome on fontless hosts.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_VEIL_METRIC_FONTS_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_VEIL_METRIC_FONTS_H_
+
+#include <string>
+
+#include "third_party/skia/include/core/SkTypeface.h"
+
+namespace blink {
+namespace veil {
+
+// Decodes (lazily, once per process) the embedded metric clone and returns
+// it as an SkTypeface. Returns nullptr when |key| names no embedded font.
+sk_sp<SkTypeface> VeilEmbeddedTypeface(const std::string& key);
+
+}  // namespace veil
