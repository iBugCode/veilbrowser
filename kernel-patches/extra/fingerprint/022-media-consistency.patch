 mojom::blink::PointerType MediaValues::CalculatePrimaryPointerType(
     LocalFrame* frame) {
+  // veilbrowser: headless advertises no pointer at all; a real desktop
+  // session always has a fine pointer. Keeping (pointer: fine) consistent
+  // with the spoofed platform closes the matchMedia tell.
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  if (command_line->HasSwitch(switches::kFingerprint)) {
+    return mojom::blink::PointerType::kPointerFineType;
+  }
   DCHECK(frame);
   DCHECK(frame->GetSettings());
   return frame->GetSettings()->GetPrimaryPointerType();
 }
 
