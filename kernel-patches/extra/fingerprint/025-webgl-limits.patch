+// veilbrowser: plausible texture-size ceiling for the spoofed GPU. NVIDIA
+// desktop parts report 32768; the rest of the desktop field reports 16384.
+int64_t VeilWebGLSizeLimit(int64_t swiftshader_value) {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(switches::kFingerprint)) {
+    return swiftshader_value;
+  }
+  static const int64_t kLimit = [] {
+    std::string renderer = GetGLRendererStringForFingerprint();
+    return renderer.find("NVIDIA") != std::string::npos ? 32768 : 16384;
+  }();
+  return kLimit;
+}
