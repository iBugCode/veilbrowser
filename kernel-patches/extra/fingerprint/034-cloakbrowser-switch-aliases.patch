 namespace switches {
@@ -57,4 +58,20 @@ const char kFingerprintLocation[] = "fingerprint-location";
 // Specify the timezone
 const char kFingerprintTimezone[] = "timezone";
 
+// Specify the timezone (CloakBrowser-compatible alias for kFingerprintTimezone)
+const char kFingerprintTimezoneAlias[] = "fingerprint-timezone";
+
+std::string GetFingerprintTimezoneOverride() {
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  for (const char* name : {kFingerprintTimezone, kFingerprintTimezoneAlias}) {
+    if (command_line->HasSwitch(name)) {
+      std::string value = command_line->GetSwitchValueASCII(name);
+      if (!value.empty()) {
+        return value;
+      }
+    }
+  }
+  return std::string();
+}
+
 }  // namespace switches
