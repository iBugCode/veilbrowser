+
+#ifndef CHROME_RENDERER_VEIL_VEIL_BUNDLE_H_
+#define CHROME_RENDERER_VEIL_VEIL_BUNDLE_H_
+
+namespace veil {
+
+// Bundle template (prelude + script) carrying two substitution slots:
+// __VEIL_PARAMS_JSON__ (per-profile parameters, small JSON) and
+// __VEIL_CFG__ (the cfg expression inside the bundle IIFE).
+extern const char kVeilScriptTemplate[];
